<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette -->
    <Color x:Key="DarkWindowBackgroundColor">#0B0F18</Color>
    <Color x:Key="DarkHeaderBackgroundColor">#0F1520</Color>
    <Color x:Key="DarkSidebarBackgroundColor">#0D131E</Color>
    <Color x:Key="DarkSurfaceColor">#141C29</Color>
    <Color x:Key="DarkSurfaceElevatedColor">#192334</Color>
    <Color x:Key="DarkSurfaceHoverColor">#202C3E</Color>
    <Color x:Key="DarkBorderColor">#273449</Color>
    <Color x:Key="DarkPrimaryTextColor">#F4F7FC</Color>
    <Color x:Key="DarkSecondaryTextColor">#A3AFC2</Color>
    <Color x:Key="DarkMutedTextColor">#748096</Color>
    <Color x:Key="DarkInputBackgroundColor">#101722</Color>

    <!-- Light palette -->
    <Color x:Key="LightWindowBackgroundColor">#F3F6FA</Color>
    <Color x:Key="LightHeaderBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LightSidebarBackgroundColor">#EDF2F8</Color>
    <Color x:Key="LightSurfaceColor">#FFFFFF</Color>
    <Color x:Key="LightSurfaceElevatedColor">#F7F9FC</Color>
    <Color x:Key="LightSurfaceHoverColor">#E5ECF5</Color>
    <Color x:Key="LightBorderColor">#D4DEEA</Color>
    <Color x:Key="LightPrimaryTextColor">#182235</Color>
    <Color x:Key="LightSecondaryTextColor">#58677C</Color>
    <Color x:Key="LightMutedTextColor">#7B899D</Color>
    <Color x:Key="LightInputBackgroundColor">#F0F4F9</Color>

    <!-- Accent palette -->
    <Color x:Key="BlueAccentColor">#79A7FF</Color>
    <Color x:Key="VioletAccentColor">#A594FF</Color>
    <Color x:Key="TealAccentColor">#51D1C4</Color>
    <Color x:Key="AccentButtonTextColor">#08111F</Color>

    <!-- Active resources default to Dark / Blue and are replaced in memory at runtime. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource DarkWindowBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource DarkHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource DarkSidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource DarkSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource DarkSurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource DarkPrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource DarkSecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource DarkMutedTextColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource DarkInputBackgroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BlueAccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2479A7FF" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#8079A7FF" />
    <SolidColorBrush x:Key="AccentButtonTextBrush" Color="{StaticResource AccentButtonTextColor}" />
    <SolidColorBrush x:Key="BlueAccentBrush" Color="{StaticResource BlueAccentColor}" />
    <SolidColorBrush x:Key="VioletAccentBrush" Color="{StaticResource VioletAccentColor}" />
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccentColor}" />
</ResourceDictionary>
