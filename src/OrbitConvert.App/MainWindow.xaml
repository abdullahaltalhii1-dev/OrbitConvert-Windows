<Window x:Class="OrbitConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:OrbitConvert.App.ViewModels"
        xmlns:views="clr-namespace:OrbitConvert.App.Views"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          FlowDirection="{Binding Localization.FlowDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native window chrome is intentionally retained. -->
        <views:HeaderView Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:SidebarView Grid.Column="0" />

            <Grid Grid.Column="1">
                <views:WorkspaceView Visibility="{Binding IsWorkspaceSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ImagesView IsEnabled="{Binding CanUseImages}"
                                  Visibility="{Binding IsImagesSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:VideosView IsEnabled="{Binding CanUseVideo}"
                                  Visibility="{Binding IsVideoSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:AudiosView IsEnabled="{Binding CanUseAudio}"
                                  Visibility="{Binding IsAudioSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:DocumentsView IsEnabled="{Binding CanUseDocuments}"
                                     Visibility="{Binding IsDocumentsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:PdfView IsEnabled="{Binding CanUsePdf}" Visibility="{Binding IsPdfSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ArchivesView IsEnabled="{Binding CanUseArchives}" Visibility="{Binding IsArchivesSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:BatchView IsEnabled="{Binding CanUseBatch}" Visibility="{Binding IsBatchSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:SettingsView Visibility="{Binding IsSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
