<Window x:Class="OrbitConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:OrbitConvert.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native window chrome is intentionally retained. -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid Width="26" Height="26">
                        <Ellipse Width="23"
                                 Height="12"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="1.8"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-28" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="6"
                                 Height="6"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,2,2,0"
                                 Fill="{DynamicResource AccentBrush}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding AppTitle}" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="STUDIO / WINDOWS" />
                </StackPanel>

                <Border Grid.Column="2"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BadgeBorderStyle}">
                    <TextBlock Style="{StaticResource BadgeTextStyle}"
                               Text="UI PREVIEW" />
                </Border>

                <Border Grid.Column="3"
                        Padding="3"
                        VerticalAlignment="Center"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton AutomationProperties.Name="Use dark theme"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="{x:Static viewModels:AppTheme.Dark}"
                                     Content="Dark"
                                     GroupName="HeaderTheme"
                                     IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                     Style="{StaticResource SegmentRadioStyle}" />
                        <RadioButton AutomationProperties.Name="Use light theme"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="{x:Static viewModels:AppTheme.Light}"
                                     Content="Light"
                                     GroupName="HeaderTheme"
                                     IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                     Style="{StaticResource SegmentRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16,22,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="12,0,0,10"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="STUDIO SECTIONS" />

                    <StackPanel Grid.Row="1">
                        <RadioButton AutomationProperties.Name="Workspace"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static viewModels:AppSection.Workspace}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsWorkspaceSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16"
                                      Height="16"
                                      Data="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Workspace" />
                            </Grid>
                        </RadioButton>

                        <RadioButton AutomationProperties.Name="Images demo preview"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static viewModels:AppSection.Images}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsImagesSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="17"
                                      Height="16"
                                      Data="M1,2 H17 V16 H1 Z M3,13 L7,8 L10,11 L13,7 L16,13 Z M12,5 A1.5,1.5 0 1 0 15,5 A1.5,1.5 0 1 0 12,5"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Images" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="DEMO" />
                            </Grid>
                        </RadioButton>

                        <RadioButton AutomationProperties.Name="Video coming soon"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static viewModels:AppSection.Video}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsVideoSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="17"
                                      Height="16"
                                      Data="M1,2 H13 V16 H1 Z M13,7 L18,4 V14 L13,11 Z M6,6 L10,9 L6,12 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Video" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="SOON" />
                            </Grid>
                        </RadioButton>

                        <RadioButton AutomationProperties.Name="Audio coming soon"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static viewModels:AppSection.Audio}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsAudioSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16"
                                      Height="17"
                                      Data="M6,3 V13 A3,3 0 1 1 4,10 H6 V5 L15,3 V11 A3,3 0 1 1 13,8 V4 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Audio" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="SOON" />
                            </Grid>
                        </RadioButton>

                        <RadioButton AutomationProperties.Name="Documents coming soon"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static viewModels:AppSection.Documents}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsDocumentsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="15"
                                      Height="17"
                                      Data="M2,1 H11 L16,6 V18 H2 Z M10,2 V7 H15 M5,10 H13 M5,13 H13 M5,16 H10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Documents" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="SOON" />
                            </Grid>
                        </RadioButton>

                        <Border Height="1"
                                Margin="12,13"
                                Background="{DynamicResource BorderBrush}" />

                        <RadioButton AutomationProperties.Name="Settings preview"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static viewModels:AppSection.Settings}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="17"
                                      Height="17"
                                      Data="M9,1 L10.5,3.2 L13.2,2.8 L14.2,5.3 L16.5,6.7 L15.5,9.2 L16.5,11.7 L14.2,13.1 L13.2,15.6 L10.5,15.2 L9,17.4 L7.5,15.2 L4.8,15.6 L3.8,13.1 L1.5,11.7 L2.5,9.2 L1.5,6.7 L3.8,5.3 L4.8,2.8 L7.5,3.2 Z M9,6 A3,3 0 1 0 9,12 A3,3 0 1 0 9,6"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Settings" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Padding="12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="PHASE 1.1" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="UI shell · No file access" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Workspace -->
            <ScrollViewer Grid.Column="1">
                <ScrollViewer.Style>
                    <Style BasedOn="{StaticResource PageScrollViewerStyle}"
                           TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="{x:Static viewModels:AppSection.Workspace}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="980">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="WORKSPACE" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="Convert without the clutter." />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="One clean workspace for all your file conversions." />

                    <Grid Height="258" Margin="0,28,0,0">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18" />
                        <Rectangle Margin="8"
                                   Fill="Transparent"
                                   RadiusX="14"
                                   RadiusY="14"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeDashArray="5,5"
                                   StrokeThickness="1.3" />
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="58"
                                    Height="58"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="17">
                                <Path Width="24"
                                      Height="24"
                                      Data="M12,3 V16 M7,8 L12,3 L17,8 M5,15 V20 H19 V15"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock Margin="0,15,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Text="Your next file starts here." />
                            <TextBlock MaxWidth="430"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="File selection arrives in a later phase. This workspace is a visual preview only." />
                            <Button Margin="0,15,0,0"
                                    AutomationProperties.HelpText="File selection is not available in Phase 1.1"
                                    Content="Browse Files · Coming soon"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CompactCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="10">
                                    <Path Width="15"
                                          Height="17"
                                          Data="M3,8 V6 A5,5 0 0 1 13,6 V8 M2,8 H14 V17 H2 Z M8,11 V14"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.6"
                                          Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="Private Processing" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="Designed for local workflows. No uploads or cloud processing are active." />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CompactCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="10">
                                    <Path Width="17"
                                          Height="17"
                                          Data="M1,3 H7 V9 H1 Z M10,3 H16 V9 H10 Z M1,12 H7 V18 H1 Z M10,12 H16 V18 H10 Z"
                                          Fill="{DynamicResource AccentBrush}"
                                          Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="Multiple Formats" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="A focused home for image, video, audio, and document tools planned ahead." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Images demo -->
            <ScrollViewer Grid.Column="1">
                <ScrollViewer.Style>
                    <Style BasedOn="{StaticResource PageScrollViewerStyle}"
                           TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="{x:Static viewModels:AppSection.Images}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="980">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="IMAGES" />
                        <Border Margin="10,0,0,0" Style="{StaticResource BadgeBorderStyle}">
                            <TextBlock Style="{StaticResource BadgeTextStyle}"
                                       Text="FICTIONAL DEMO" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="Shape the output before it exists." />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Explore a sample conversion layout. No file is loaded, read, or created." />

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.92*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Height="220">
                                    <Border ClipToBounds="True" CornerRadius="13">
                                        <Grid>
                                            <Grid.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#243B67" />
                                                    <GradientStop Offset="0.52" Color="#466F92" />
                                                    <GradientStop Offset="1" Color="#D08A6C" />
                                                </LinearGradientBrush>
                                            </Grid.Background>
                                            <Ellipse Width="84"
                                                     Height="84"
                                                     Margin="0,26,36,0"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Top"
                                                     Fill="#77FFE0A6" />
                                            <Path Margin="0,54,0,0"
                                                  VerticalAlignment="Bottom"
                                                  Data="M0,100 L90,25 L145,72 L210,12 L320,100 Z"
                                                  Fill="#CC15283D"
                                                  Stretch="Fill" />
                                            <Path Margin="0,95,0,0"
                                                  VerticalAlignment="Bottom"
                                                  Data="M0,75 L65,28 L118,62 L185,22 L255,75 Z"
                                                  Fill="#E6234052"
                                                  Stretch="Fill" />
                                        </Grid>
                                    </Border>
                                    <Border Margin="12"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource BadgeBorderStyle}">
                                        <TextBlock Style="{StaticResource BadgeTextStyle}"
                                                   Text="DEMO IMAGE" />
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,18,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="landscape_demo.png" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Fictional in-memory sample" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Padding="12"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       Text="SAMPLE SIZE" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="4.8 MB" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Padding="12"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       Text="DIMENSIONS" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="3840 × 2160" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="Output Preview" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="Controls update preview text only." />

                                <TextBlock Margin="0,22,0,8"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="EXAMPLE FORMAT" />
                                <Border Padding="3"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <UniformGrid Columns="3">
                                        <RadioButton AutomationProperties.Name="Preview WebP output"
                                                     Command="{Binding SetOutputFormatCommand}"
                                                     CommandParameter="{x:Static viewModels:ImageOutputFormat.WebP}"
                                                     Content="WebP"
                                                     GroupName="OutputFormat"
                                                     IsChecked="{Binding IsWebPSelected, Mode=OneWay}"
                                                     Style="{StaticResource FormatRadioStyle}" />
                                        <RadioButton AutomationProperties.Name="Preview JPG output"
                                                     Command="{Binding SetOutputFormatCommand}"
                                                     CommandParameter="{x:Static viewModels:ImageOutputFormat.Jpg}"
                                                     Content="JPG"
                                                     GroupName="OutputFormat"
                                                     IsChecked="{Binding IsJpgSelected, Mode=OneWay}"
                                                     Style="{StaticResource FormatRadioStyle}" />
                                        <RadioButton AutomationProperties.Name="Preview PNG output"
                                                     Command="{Binding SetOutputFormatCommand}"
                                                     CommandParameter="{x:Static viewModels:ImageOutputFormat.Png}"
                                                     Content="PNG"
                                                     GroupName="OutputFormat"
                                                     IsChecked="{Binding IsPngSelected, Mode=OneWay}"
                                                     Style="{StaticResource FormatRadioStyle}" />
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,22,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                               Text="EXAMPLE QUALITY" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding PreviewQualityText}" />
                                </Grid>
                                <Slider AutomationProperties.Name="Example output quality"
                                        IsEnabled="{Binding IsQualityEnabled}"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Maximum="100"
                                        Minimum="25"
                                        TickFrequency="5"
                                        Value="{Binding PreviewQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Margin="0,22,0,0"
                                        Padding="14"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Text="OUTPUT FILENAME PREVIEW" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding OutputPreviewFileName}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding OutputPreviewSummary}" />
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,20,0,0"
                                        AutomationProperties.HelpText="Conversion is not available in Phase 1.1"
                                        Content="Convert · Coming soon"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="No file will be created in this preview." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Video coming soon -->
            <ScrollViewer Grid.Column="1">
                <ScrollViewer.Style>
                    <Style BasedOn="{StaticResource PageScrollViewerStyle}"
                           TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="{x:Static viewModels:AppSection.Video}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="780">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="VIDEO" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="Video tools are on the horizon." />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="This polished placeholder communicates direction without enabling unfinished functionality." />
                    <Border Margin="0,30,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Padding="10,5" Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="COMING SOON" />
                            </Border>
                            <Path Width="68"
                                  Height="54"
                                  Margin="0,28,0,0"
                                  Data="M2,2 H48 V42 H2 Z M48,14 L66,5 V39 L48,30 Z M20,13 L34,22 L20,31 Z"
                                  Fill="{DynamicResource AccentSoftBrush}"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform" />
                            <TextBlock Margin="0,24,0,0"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Planned video formats" />
                            <StackPanel Margin="0,14,0,6" Orientation="Horizontal">
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="MP4" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="MOV" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="MKV" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="WebM" /></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Informational only · No media is opened or processed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Audio coming soon -->
            <ScrollViewer Grid.Column="1">
                <ScrollViewer.Style>
                    <Style BasedOn="{StaticResource PageScrollViewerStyle}"
                           TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="{x:Static viewModels:AppSection.Audio}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="780">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="AUDIO" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="A quieter way to handle audio." />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Audio conversion is planned for a later approved phase and is not active here." />
                    <Border Margin="0,30,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Padding="10,5" Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="COMING SOON" />
                            </Border>
                            <Path Width="62"
                                  Height="62"
                                  Margin="0,28,0,0"
                                  Data="M8,5 V43 A10,10 0 1 1 2,34 H8 V10 L48,3 V36 A10,10 0 1 1 42,27 V8 Z"
                                  Fill="{DynamicResource AccentSoftBrush}"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform" />
                            <TextBlock Margin="0,24,0,0"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Planned audio formats" />
                            <StackPanel Margin="0,14,0,6" Orientation="Horizontal">
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="MP3" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="WAV" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="FLAC" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="M4A" /></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Informational only · No audio is opened or processed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Documents coming soon -->
            <ScrollViewer Grid.Column="1">
                <ScrollViewer.Style>
                    <Style BasedOn="{StaticResource PageScrollViewerStyle}"
                           TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="{x:Static viewModels:AppSection.Documents}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="780">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DOCUMENTS" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="Documents, thoughtfully organized." />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Document workflows remain intentionally disabled until their own implementation phase." />
                    <Border Margin="0,30,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Padding="10,5" Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="COMING SOON" />
                            </Border>
                            <Path Width="54"
                                  Height="68"
                                  Margin="0,28,0,0"
                                  Data="M3,2 H34 L51,19 V66 H3 Z M33,3 V21 H50 M12,33 H42 M12,42 H42 M12,51 H34"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform" />
                            <TextBlock Margin="0,24,0,0"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Planned document formats" />
                            <StackPanel Margin="0,14,0,6" Orientation="Horizontal">
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="PDF" /></Border>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}"><TextBlock Text="DOCX" /></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Informational only · No document is opened or processed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings preview -->
            <ScrollViewer Grid.Column="1">
                <ScrollViewer.Style>
                    <Style BasedOn="{StaticResource PageScrollViewerStyle}"
                           TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="{x:Static viewModels:AppSection.Settings}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="820">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SETTINGS / PREVIEW" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="Make the studio feel like yours." />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Appearance choices apply to this session only and are never written to disk." />

                    <Border Margin="0,28,0,0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Theme" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="Switch between the dark studio and a bright workspace." />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Padding="3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton AutomationProperties.Name="Settings dark theme"
                                                     Command="{Binding SetThemeCommand}"
                                                     CommandParameter="{x:Static viewModels:AppTheme.Dark}"
                                                     Content="Dark"
                                                     GroupName="SettingsTheme"
                                                     IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                                     Style="{StaticResource SegmentRadioStyle}" />
                                        <RadioButton AutomationProperties.Name="Settings light theme"
                                                     Command="{Binding SetThemeCommand}"
                                                     CommandParameter="{x:Static viewModels:AppTheme.Light}"
                                                     Content="Light"
                                                     GroupName="SettingsTheme"
                                                     IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                                     Style="{StaticResource SegmentRadioStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

                            <Grid Grid.Row="2" Margin="0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Accent color" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="Choose a preview accent for focus, selection, and highlights." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <RadioButton AutomationProperties.Name="Blue accent"
                                                 Background="{StaticResource BlueAccentBrush}"
                                                 Command="{Binding SetAccentCommand}"
                                                 CommandParameter="{x:Static viewModels:AccentChoice.Blue}"
                                                 GroupName="AccentSelection"
                                                 IsChecked="{Binding IsBlueAccent, Mode=OneWay}"
                                                 Style="{StaticResource AccentRadioStyle}" />
                                    <RadioButton AutomationProperties.Name="Violet accent"
                                                 Background="{StaticResource VioletAccentBrush}"
                                                 Command="{Binding SetAccentCommand}"
                                                 CommandParameter="{x:Static viewModels:AccentChoice.Violet}"
                                                 GroupName="AccentSelection"
                                                 IsChecked="{Binding IsVioletAccent, Mode=OneWay}"
                                                 Style="{StaticResource AccentRadioStyle}" />
                                    <RadioButton AutomationProperties.Name="Teal accent"
                                                 Background="{StaticResource TealAccentBrush}"
                                                 Command="{Binding SetAccentCommand}"
                                                 CommandParameter="{x:Static viewModels:AccentChoice.Teal}"
                                                 GroupName="AccentSelection"
                                                 IsChecked="{Binding IsTealAccent, Mode=OneWay}"
                                                 Style="{StaticResource AccentRadioStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />

                            <Border Grid.Row="4"
                                    Margin="0,22,0,0"
                                    Padding="15"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Text="i" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="Session-only preview: no settings file, registry entry, account, or cloud service is used." />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
