<Window x:Class="OrbitConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:OrbitConvert.App.ViewModels"
        xmlns:views="clr-namespace:OrbitConvert.App.Views"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          FlowDirection="{Binding Localization.FlowDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native window chrome is intentionally retained. -->
        <views:HeaderView Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:SidebarView Grid.Column="0" />

            <Grid Grid.Column="1">
                <views:WorkspaceView Visibility="{Binding IsWorkspaceSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ImagesPreviewView Visibility="{Binding IsImagesSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:ComingSoonView Eyebrow="{Binding Localization[VideoEyebrow]}"
                                      Title="{Binding Localization[VideoTitle]}"
                                      Description="{Binding Localization[VideoDescription]}"
                                      IconData="M2,2 H48 V42 H2 Z M48,14 L66,5 V39 L48,30 Z M20,13 L34,22 L20,31 Z"
                                      IconWidth="68"
                                      IconHeight="54"
                                      IconFill="{DynamicResource AccentSoftBrush}"
                                      FormatsHeading="{Binding Localization[VideoFormatsHeading]}"
                                      Formats="MP4|MOV|MKV|WebM"
                                      InformationalText="{Binding Localization[VideoInformationalText]}"
                                      Visibility="{Binding IsVideoSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:ComingSoonView Eyebrow="{Binding Localization[AudioEyebrow]}"
                                      Title="{Binding Localization[AudioTitle]}"
                                      Description="{Binding Localization[AudioDescription]}"
                                      IconData="M8,5 V43 A10,10 0 1 1 2,34 H8 V10 L48,3 V36 A10,10 0 1 1 42,27 V8 Z"
                                      IconWidth="62"
                                      IconHeight="62"
                                      IconFill="{DynamicResource AccentSoftBrush}"
                                      FormatsHeading="{Binding Localization[AudioFormatsHeading]}"
                                      Formats="MP3|WAV|FLAC|M4A"
                                      InformationalText="{Binding Localization[AudioInformationalText]}"
                                      Visibility="{Binding IsAudioSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:ComingSoonView Eyebrow="{Binding Localization[DocumentsEyebrow]}"
                                      Title="{Binding Localization[DocumentsTitle]}"
                                      Description="{Binding Localization[DocumentsDescription]}"
                                      IconData="M3,2 H34 L51,19 V66 H3 Z M33,3 V21 H50 M12,33 H42 M12,42 H42 M12,51 H34"
                                      IconWidth="54"
                                      IconHeight="68"
                                      FormatsHeading="{Binding Localization[DocumentsFormatsHeading]}"
                                      Formats="PDF|DOCX"
                                      InformationalText="{Binding Localization[DocumentsInformationalText]}"
                                      Visibility="{Binding IsDocumentsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:SettingsView Visibility="{Binding IsSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
