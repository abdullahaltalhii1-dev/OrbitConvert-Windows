<UserControl x:Class="OrbitConvert.App.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:OrbitConvert.App.ViewModels"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Border Background="{DynamicResource HeaderBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="42"
                    Height="42"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid Width="26" Height="26">
                    <Ellipse Width="23"
                             Height="12"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="1.8"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-28" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6"
                             Height="6"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,2,2,0"
                             Fill="{DynamicResource AccentBrush}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Text="{Binding AppTitle}" />
                <TextBlock Margin="0,2,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="STUDIO / WINDOWS" />
            </StackPanel>

            <Border Grid.Column="2"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BadgeBorderStyle}">
                <TextBlock Style="{StaticResource BadgeTextStyle}"
                           Text="UI PREVIEW" />
            </Border>

            <Border Grid.Column="3"
                    Padding="3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton AutomationProperties.Name="Use dark theme"
                                 Command="{Binding SetThemeCommand}"
                                 CommandParameter="{x:Static viewModels:AppTheme.Dark}"
                                 Content="Dark"
                                 GroupName="HeaderTheme"
                                 IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                 Style="{StaticResource SegmentRadioStyle}" />
                    <RadioButton AutomationProperties.Name="Use light theme"
                                 Command="{Binding SetThemeCommand}"
                                 CommandParameter="{x:Static viewModels:AppTheme.Light}"
                                 Content="Light"
                                 GroupName="HeaderTheme"
                                 IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                 Style="{StaticResource SegmentRadioStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
