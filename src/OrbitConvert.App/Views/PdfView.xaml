<UserControl x:Class="OrbitConvert.App.Views.PdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="PdfMergeListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel MaxWidth="980">
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PDF" FlowDirection="LeftToRight" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitleTextStyle}" Text="{Binding Localization[PdfTitle]}" />
            <TextBlock Margin="0,7,0,20" Style="{StaticResource BodyTextStyle}" Text="{Binding Localization[PdfDescription]}" />
            <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Localization[PdfOperation]}" />
                <ComboBox Margin="0,12,0,12" Style="{StaticResource ImageComboBoxStyle}" ItemsSource="{Binding Pdf.ModeOptions}" DisplayMemberPath="Label" SelectedIndex="{Binding Pdf.ModeIndex, Mode=TwoWay}"
                          IsEnabled="{Binding Pdf.IsIdle}" AutomationProperties.Name="{Binding Localization[PdfOperation]}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[PdfSourceHelp]}" />
                <ComboBox Margin="0,12,0,0" Style="{StaticResource ImageSourceComboBoxStyle}" ItemsSource="{Binding FileIntake.SelectedFiles}"
                          SelectedItem="{Binding Pdf.SelectedFile, Mode=TwoWay}" IsEnabled="{Binding Pdf.IsIdle}" FlowDirection="LeftToRight"
                          AutomationProperties.Name="{Binding Localization[PdfSource]}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel IsEnabled="{Binding Pdf.IsIdle}" Visibility="{Binding Pdf.IsMerge, Converter={StaticResource BoolVisibility}}">
                    <Button Margin="0,12,0,8" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[PdfAddMerge]}" Command="{Binding Pdf.AddMergeCommand}" />
                    <ListBox MaxHeight="160" Style="{StaticResource PdfMergeListStyle}"
                             ItemsSource="{Binding Pdf.MergeFiles}" SelectedItem="{Binding Pdf.MergeSelection, Mode=TwoWay}" FlowDirection="LeftToRight"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Localization[PdfMergeOrder]}">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[PdfMoveUp]}" Command="{Binding Pdf.MoveUpCommand}" />
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[PdfMoveDown]}" Command="{Binding Pdf.MoveDownCommand}" />
                        <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[Remove]}" Command="{Binding Pdf.RemoveMergeCommand}" />
                    </WrapPanel>
                </StackPanel>
                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[PdfInspect]}" Command="{Binding Pdf.InspectCommand}" />
                <TextBlock Margin="0,12,0,8" Style="{StaticResource BodyTextStyle}" Text="{Binding Pdf.TotalPages}" />
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pdf.InspectionDetails}"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Margin="0,3,0,3" Style="{StaticResource CaptionTextStyle}" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </StackPanel></Border>
            <Border Margin="0,18,0,0" Style="{StaticResource CardBorderStyle}"><StackPanel>
                <ComboBox Margin="0,0,0,12" Style="{StaticResource ImageComboBoxStyle}" ItemsSource="{Binding Pdf.SplitOptions}" DisplayMemberPath="Label" SelectedIndex="{Binding Pdf.SplitModeIndex, Mode=TwoWay}"
                          IsEnabled="{Binding Pdf.IsIdle}" Visibility="{Binding Pdf.IsSplit, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Localization[PdfSplitMode]}" />
                <StackPanel IsEnabled="{Binding Pdf.IsIdle}" Visibility="{Binding Pdf.ShowsPages, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Pdf.SelectionHelp}" />
                    <TextBox Margin="0,8,0,12" Style="{StaticResource ImageDimensionTextBoxStyle}" Text="{Binding Pdf.PagesText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxLength="2000"
                             AutomationProperties.Name="{Binding Localization[PdfPageSelection]}" />
                </StackPanel>
                <StackPanel IsEnabled="{Binding Pdf.IsIdle}" Visibility="{Binding Pdf.IsRender, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[PdfDpi]}" />
                    <ComboBox Margin="0,8,0,12" Style="{StaticResource ImageComboBoxStyle}" ItemsSource="{Binding Pdf.DpiOptions}" SelectedItem="{Binding Pdf.Dpi, Mode=TwoWay}" FlowDirection="LeftToRight"
                              AutomationProperties.Name="{Binding Localization[PdfDpi]}" />
                </StackPanel>
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Pdf.SettingsError}" />
                <TextBlock Margin="0,8,0,14" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[PdfPolicy]}" />
                <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Pdf.DestinationLabel}" IsEnabled="{Binding Pdf.CanChooseDestination}" Click="ChooseDestination_Click" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Pdf.DestinationPath}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                <WrapPanel Margin="0,14,0,0">
                    <Button Margin="0,0,10,8" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Localization[PdfStart]}" Command="{Binding Pdf.StartCommand}" />
                    <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[PdfCancel]}" Command="{Binding Pdf.CancelCommand}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding Pdf.IsBusy, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Pdf.StageText}" />
                    <ProgressBar Margin="0,8,0,8" Height="8" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{Binding Localization[PdfProgress]}" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding Pdf.StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Pdf.CompletedPath}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                <TextBox Margin="0,12,0,0" MaxHeight="220" Style="{StaticResource ImageDimensionTextBoxStyle}" IsReadOnly="True" Text="{Binding Pdf.TextPreview, Mode=OneWay}"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="{Binding Localization.FlowDirection}" AutomationProperties.Name="{Binding Localization[PdfTextPreview]}" />
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
