<UserControl x:Class="OrbitConvert.App.Views.ComingSoonView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel MaxWidth="780">
            <TextBlock Style="{StaticResource EyebrowTextStyle}"
                       Text="{Binding Eyebrow, ElementName=Root}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource PageTitleTextStyle}"
                       Text="{Binding Title, ElementName=Root}" />
            <TextBlock Margin="0,7,0,0"
                       Style="{StaticResource BodyTextStyle}"
                       Text="{Binding Description, ElementName=Root}" />

            <Border Margin="0,30,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Padding="10,5" Style="{StaticResource BadgeBorderStyle}">
                        <TextBlock Style="{StaticResource BadgeTextStyle}"
                                   Text="{Binding DataContext.Localization[ComingSoon], ElementName=Root}" />
                    </Border>
                    <Path Width="{Binding IconWidth, ElementName=Root}"
                          Height="{Binding IconHeight, ElementName=Root}"
                          Margin="0,28,0,0"
                          Data="{Binding IconData, ElementName=Root}"
                          Fill="{Binding IconFill, ElementName=Root}"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.5"
                          Stretch="Uniform" />
                    <TextBlock Margin="0,24,0,0"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Text="{Binding FormatsHeading, ElementName=Root}" />
                    <ItemsControl x:Name="FormatItems"
                                  Margin="0,14,0,6"
                                  FlowDirection="LeftToRight">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding InformationalText, ElementName=Root}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
