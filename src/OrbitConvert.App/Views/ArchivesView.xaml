<UserControl x:Class="OrbitConvert.App.Views.ArchivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="ArchiveListStyle" TargetType="ListBox">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel MaxWidth="980">
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ZIP / TAR / 7z" FlowDirection="LeftToRight" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitleTextStyle}" Text="{Binding Localization[ArchiveTitle]}" />
            <TextBlock Margin="0,7,0,20" Style="{StaticResource BodyTextStyle}" Text="{Binding Localization[ArchiveDescription]}" />
            <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Localization[ArchiveOperation]}" />
                <ComboBox Margin="0,12,0,12" Style="{StaticResource ImageComboBoxStyle}" ItemsSource="{Binding Archives.ModeOptions}"
                          SelectedIndex="{Binding Archives.ModeIndex, Mode=TwoWay}" IsEnabled="{Binding Archives.IsIdle}" AutomationProperties.Name="{Binding Localization[ArchiveOperation]}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[ArchiveSourceHelp]}" />
                <ComboBox Margin="0,12,0,8" Style="{StaticResource ImageSourceComboBoxStyle}" ItemsSource="{Binding FileIntake.SelectedFiles}"
                          SelectedItem="{Binding Archives.SelectedFile, Mode=TwoWay}" IsEnabled="{Binding Archives.IsIdle}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Localization[ArchiveSource]}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[ArchiveBrowse]}" IsEnabled="{Binding Archives.IsIdle}" Click="Browse_Click" />
                <StackPanel Margin="0,12,0,0" IsEnabled="{Binding Archives.IsIdle}" Visibility="{Binding Archives.IsCreate, Converter={StaticResource BoolVisibility}}">
                    <WrapPanel>
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[ArchiveAdd]}" Command="{Binding Archives.AddCommand}" />
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[ArchiveChooseFolder]}" Click="ChooseFolder_Click" />
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[Remove]}" Command="{Binding Archives.RemoveCommand}" />
                        <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[ClearAll]}" Command="{Binding Archives.ClearCommand}" />
                    </WrapPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Background="{DynamicResource SurfaceBrush}">
                        <ListBox MaxHeight="150" Style="{StaticResource ArchiveListStyle}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" ItemsSource="{Binding Archives.CreationFiles}"
                                 SelectedItem="{Binding Archives.CreationSelection, Mode=TwoWay}" FlowDirection="LeftToRight" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Localization[ArchiveCreationFiles]}">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Archives.FolderSource}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[ArchiveCreationHelp]}" />
                </StackPanel>
                <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[ArchiveInspect]}" Command="{Binding Archives.InspectCommand}" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding Archives.SelectionSummary}" />
                <ScrollViewer MaxHeight="200" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Localization[ArchiveContents]}">
                    <ItemsControl ItemsSource="{Binding Archives.ContentRows}" FlowDirection="LeftToRight"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Margin="0,4,0,4" Style="{StaticResource CaptionTextStyle}" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </StackPanel></Border>
            <Border Margin="0,18,0,0" Style="{StaticResource CardBorderStyle}"><StackPanel>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[ArchivePolicy]}" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Archives.DestinationLabel}" IsEnabled="{Binding Archives.CanChooseDestination}" Click="ChooseDestination_Click" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Archives.DestinationPath}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                <WrapPanel Margin="0,14,0,0">
                    <Button Margin="0,0,10,8" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Localization[ArchiveStart]}" Command="{Binding Archives.StartCommand}" />
                    <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[ArchiveCancel]}" Command="{Binding Archives.CancelCommand}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding Archives.IsBusy, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Archives.StageText}" />
                    <ProgressBar Margin="0,8,0,8" Height="8" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{Binding Localization[ArchiveProgress]}" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding Archives.StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Archives.CompletedPath}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
