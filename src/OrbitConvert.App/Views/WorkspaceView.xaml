<UserControl x:Class="OrbitConvert.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DropZoneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragActive, ElementName=Root}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel MaxWidth="980">
            <TextBlock Style="{StaticResource EyebrowTextStyle}"
                       Text="{Binding Localization[WorkspaceEyebrow]}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource PageTitleTextStyle}"
                       Text="{Binding Localization[WorkspaceTitle]}" />
            <TextBlock Margin="0,7,0,0"
                       Style="{StaticResource BodyTextStyle}"
                       Text="{Binding Localization[WorkspaceSubtitle]}" />

            <Border x:Name="DropZone"
                    Height="226"
                    Margin="0,28,0,0"
                    AllowDrop="True"
                    PreviewDragEnter="DropZone_PreviewDragEnter"
                    PreviewDragLeave="DropZone_PreviewDragLeave"
                    PreviewDragOver="DropZone_PreviewDragOver"
                    PreviewDrop="DropZone_PreviewDrop"
                    Style="{StaticResource DropZoneBorderStyle}">
                <Grid>
                    <Rectangle Margin="8"
                               Fill="Transparent"
                               IsHitTestVisible="False"
                               RadiusX="14"
                               RadiusY="14"
                               Stroke="{DynamicResource AccentBorderBrush}"
                               StrokeDashArray="5,5"
                               StrokeThickness="1.3" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Path Width="23"
                                  Height="23"
                                  Data="M12,3 V16 M7,8 L12,3 L17,8 M5,15 V20 H19 V15"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="0,13,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="{Binding Localization[DropZoneTitle]}" />
                        <TextBlock MaxWidth="480"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Localization[DropZoneDescription]}" />
                        <Button Margin="0,13,0,0"
                                AutomationProperties.HelpText="{Binding Localization[BrowseFilesHelp]}"
                                Click="BrowseFiles_Click"
                                Content="{Binding Localization[BrowseFiles]}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="13,10"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="{Binding FileIntake.HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding FileIntake.StatusMessage}" />
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                               Text="{Binding Localization[SelectedFiles]}" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding FileIntake.SelectedFileCountText}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Padding="13,7"
                        AutomationProperties.HelpText="{Binding Localization[ClearAllHelp]}"
                        Command="{Binding FileIntake.ClearFilesCommand}"
                        Content="{Binding Localization[ClearAll]}"
                        IsEnabled="{Binding FileIntake.HasSelectedFiles}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Margin="0,13,0,0"
                    Padding="24">
                <Border.Style>
                    <Style BasedOn="{StaticResource CompactCardBorderStyle}" TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FileIntake.HasSelectedFiles}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding Localization[EmptySelectionTitle]}" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding Localization[EmptySelectionDescription]}" />
                </StackPanel>
            </Border>

            <ItemsControl Margin="0,13,0,0"
                          ItemsSource="{Binding FileIntake.SelectedFiles}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FileIntake.HasSelectedFiles}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,9"
                                Padding="14"
                                Style="{StaticResource CompactCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="9">
                                    <Path Width="17"
                                          Height="22"
                                          Data="M3,2 H12 L19,9 V25 H3 Z M12,2 V9 H19"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="0,1,14,0"
                                            VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.Name="{Binding FileName}"
                                               FlowDirection="LeftToRight"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <TextBlock FlowDirection="LeftToRight" Text="{Binding FullPath}" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <Border Margin="0,0,8,0" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock FlowDirection="LeftToRight"
                                                       Style="{StaticResource BadgeTextStyle}"
                                                       Text="{Binding FileType}" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding DisplaySize}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="76"
                                        Padding="12,7"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{Binding DataContext.Localization[RemoveHelp], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        Command="{Binding DataContext.FileIntake.RemoveFileCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding DataContext.Localization[Remove], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CompactCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10">
                            <Path Width="15"
                                  Height="17"
                                  Data="M3,8 V6 A5,5 0 0 1 13,6 V8 M2,8 H14 V17 H2 Z M8,11 V14"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="{Binding Localization[PrivateProcessingTitle]}" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="{Binding Localization[PrivateProcessingDescription]}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CompactCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10">
                            <Path Width="17"
                                  Height="17"
                                  Data="M1,3 H7 V9 H1 Z M10,3 H16 V9 H10 Z M1,12 H7 V18 H1 Z M10,12 H16 V18 H10 Z"
                                  Fill="{DynamicResource AccentBrush}"
                                  Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="{Binding Localization[MultipleFormatsTitle]}" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="{Binding Localization[MultipleFormatsDescription]}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
