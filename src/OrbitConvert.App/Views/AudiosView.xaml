<UserControl x:Class="OrbitConvert.App.Views.AudiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:audio="clr-namespace:OrbitConvert.App.Services.Audio"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel MaxWidth="980">
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{Binding Localization[AudioEyebrow]}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitleTextStyle}" Text="{Binding Localization[AudioTitle]}" />
            <TextBlock Margin="0,7,0,22" Style="{StaticResource BodyTextStyle}" Text="{Binding Localization[AudioDescription]}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Localization[AudioSelectSource]}" />
                    <TextBlock Margin="0,6,0,12" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioSelectionHelp]}" />
                    <ComboBox ItemsSource="{Binding FileIntake.SelectedFiles}" Style="{StaticResource ImageSourceComboBoxStyle}"
                              SelectedItem="{Binding AudioConversion.SelectedFile, Mode=TwoWay}" IsEnabled="{Binding AudioConversion.IsIdle}"
                              FlowDirection="LeftToRight" MinHeight="36" MaxDropDownHeight="240" AutomationProperties.Name="{Binding Localization[AudioSelectSource]}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding Localization[AudioInspect]}" Command="{Binding AudioConversion.InspectCommand}" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioContainer]}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AudioConversion.Container}" FlowDirection="LeftToRight" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioCodec]}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AudioConversion.Codec}" FlowDirection="LeftToRight" /></StackPanel>
                        <StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioDuration]}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AudioConversion.Duration}" FlowDirection="LeftToRight" /></StackPanel>
                        <StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioSampleRate]}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AudioConversion.SourceSampleRate}" FlowDirection="LeftToRight" /></StackPanel>
                        <StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioChannels]}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AudioConversion.Channels}" /></StackPanel>
                        <StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioBitrate]}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AudioConversion.Bitrate}" FlowDirection="LeftToRight" /></StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.SourceSize}" FlowDirection="LeftToRight" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.Streams}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" Text="{Binding AudioConversion.ModeText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
                <StackPanel IsEnabled="{Binding AudioConversion.CanEditSettings}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Localization[AudioOutputSettings]}" />
                    <TextBlock Margin="0,12,0,6" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioOutputFormat]}" />
                    <ComboBox Style="{StaticResource ImageComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding AudioConversion.Format, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Localization[AudioOutputFormat]}">
                        <ComboBoxItem Content="MP3" Tag="{x:Static audio:AudioFormat.MP3}" />
                        <ComboBoxItem Content="WAV" Tag="{x:Static audio:AudioFormat.WAV}" />
                        <ComboBoxItem Content="FLAC" Tag="{x:Static audio:AudioFormat.FLAC}" />
                    </ComboBox>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding AudioConversion.IsMp3, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioMp3Bitrate]}" />
                        <ComboBox Margin="0,6,0,0" Style="{StaticResource ImageComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding AudioConversion.BitrateKbps, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Localization[AudioMp3Bitrate]}">
                            <ComboBoxItem Content="128 kbps"><ComboBoxItem.Tag><sys:Int32>128</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="192 kbps"><ComboBoxItem.Tag><sys:Int32>192</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="320 kbps"><ComboBoxItem.Tag><sys:Int32>320</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding AudioConversion.IsFlac, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioFlacLevel]}" />
                            <TextBlock Margin="12,0" Text="{Binding AudioConversion.FlacCompression}" FlowDirection="LeftToRight" /></DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding AudioConversion.FlacCompression, Mode=TwoWay}" FlowDirection="LeftToRight"
                                AutomationProperties.Name="{Binding Localization[AudioFlacLevel]}" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,6" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioOutputRate]}" />
                    <ComboBox Style="{StaticResource ImageComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding AudioConversion.SampleRate, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Localization[AudioOutputRate]}">
                        <ComboBoxItem Content="{Binding Localization[AudioPreserveRate]}"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        <ComboBoxItem Content="44.1 kHz"><ComboBoxItem.Tag><sys:Int32>44100</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        <ComboBoxItem Content="48 kHz"><ComboBoxItem.Tag><sys:Int32>48000</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                    </ComboBox>
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.FormatHelp}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding AudioConversion.SettingsError}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Localization[ImageDestination]}" />
                    <TextBlock Margin="0,8,0,12" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioMetadataPolicy]}" />
                    <Button HorizontalAlignment="Left" Click="ChooseDestination_Click" Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding Localization[AudioChooseDestination]}" IsEnabled="{Binding AudioConversion.CanChooseDestination}" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.DestinationPath}" FlowDirection="LeftToRight" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button Margin="0,0,10,8" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Localization[AudioConvert]}" Command="{Binding AudioConversion.ConvertCommand}" />
                        <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Localization[AudioCancel]}" Command="{Binding AudioConversion.CancelCommand}" />
                    </WrapPanel>
                    <StackPanel Margin="0,8,0,8" Visibility="{Binding AudioConversion.ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.ProgressText}" />
                        <ProgressBar Margin="0,8,0,8" Height="8" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}"
                                     Value="{Binding AudioConversion.ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding AudioConversion.IsProgressIndeterminate}"
                                     AutomationProperties.Name="{Binding Localization[AudioProgress]}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.Elapsed}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding AudioConversion.StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AudioConversion.CompletedPath}" FlowDirection="LeftToRight" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Localization[AudioOriginalSafe]}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
